{
  "name": "card-manipulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "wrangler dev --config server/wrangler.toml --port 8787 --inspector-port 9229 --persist-to .wrangler/state-8787 --show-interactive-dev-session=false",
    "dev:lan": "concurrently -k -n web,server \"vite --host\" \"wrangler dev --config server/wrangler.toml --ip 0.0.0.0 --port 8787 --inspector-port 9229 --persist-to .wrangler/state-8787 --show-interactive-dev-session=false\"",
    "dev:hub": "concurrently -k -n web,server \"vite --port 5177 --strictPort --mode hub\" \"wrangler dev --config server/wrangler.toml --port 8787 --inspector-port 9229 --persist-to .wrangler/state-8787 --show-interactive-dev-session=false\"",
    "dev:server-fork": "concurrently -k -n web,server \"vite --port 5174 --strictPort --mode server-fork\" \"wrangler dev --config server/wrangler.toml --port 8788 --inspector-port 9230 --persist-to .wrangler/state-8788 --show-interactive-dev-session=false\"",
    "dev:sync-fork": "concurrently -k -n web,server \"vite --port 5175 --strictPort --mode sync-fork\" \"wrangler dev --config server/wrangler.toml --port 8789 --inspector-port 9231 --persist-to .wrangler/state-8789 --show-interactive-dev-session=false\"",
    "dev:ui-fork": "concurrently -k -n web,server \"vite --port 5176 --strictPort --mode ui-fork\" \"wrangler dev --config server/wrangler.toml --port 8790 --inspector-port 9232 --persist-to .wrangler/state-8790 --show-interactive-dev-session=false\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "html-to-image": "^1.11.13",
    "pngjs": "^7.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
